{
  "name": "profile-switcher-for-claude-code",
  "displayName": "Profile Switcher for Claude Code",
  "description": "Switch quickly between multiple logged-in Claude Code accounts, no re-login needed. Open source — read the code before you install: github.com/tuanns/account-switcher-for-claude-code. / Chuyen doi nhanh giua nhieu tai khoan Claude Code da dang nhap, khong can dang nhap lai. Ma nguon mo, kiem tra truoc khi cai dat.",
  "version": "0.6.2",
  "publisher": "tuanns",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuanns/account-switcher-for-claude-code.git"
  },
  "bugs": {
    "url": "https://github.com/tuanns/account-switcher-for-claude-code/issues"
  },
  "homepage": "https://github.com/tuanns/account-switcher-for-claude-code#readme",
  "keywords": ["claude", "claude code", "account", "profile", "switcher", "multi-account", "open source"],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./out/src/extension.js",
  "l10n": "./l10n",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "profileSwitcherForClaudeCode.openMenu",
        "title": "Profile Switcher for Claude Code: Open Menu"
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "npm run compile && node --test out/test/**/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0",
    "@vscode/vsce": "^3.0.0"
  }
}
